# URL de base de l'API, telle qu'appelée depuis le navigateur.
# En dev : chemin relatif (proxié vers BACKEND_ORIGINS via les rewrites de next.config.mjs).
# En prod : peut être le même chemin relatif si le frontend et le backend sont derrière le même domaine.
NEXT_PUBLIC_API_URL=/api/v1

# Origine(s) réelle(s) du backend, séparées par des virgules si plusieurs.
# Utilisé côté serveur par next.config.mjs (rewrites, CSP, remotePatterns d'images).
# OBLIGATOIRE en production — sans cette variable, le build pointerait vers localhost:5000.
BACKEND_ORIGINS=http://localhost:5000,http://192.168.1.73:5000
